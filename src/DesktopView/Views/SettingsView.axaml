<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DesktopView.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="360"
             x:Class="DesktopView.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Border Background="{DynamicResource SystemRegionBrush}"
            CornerRadius="8"
            Padding="20"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="420">
        <StackPanel Spacing="14">

            <TextBlock Text="Settings"
                       FontSize="20" FontWeight="SemiBold" />

            <ToggleSwitch IsChecked="{Binding PersistTestData}"
                          Content="Persist test data between algorithm runs" />

            <StackPanel Spacing="6"
                        IsVisible="{Binding PersistTestData}">
                <TextBlock Text="Retention period (data ratio %):" />
                <Slider Minimum="0" Maximum="100"
                        Value="{Binding RetentionPercent}"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        Width="380" />
                <TextBlock Text="{Binding RetentionPercent, StringFormat='Retained: {0}%'}"
                           FontSize="12" Opacity="0.7" />
            </StackPanel>

            <ToggleSwitch IsChecked="{Binding EnableCaching}"
                          Content="Enable caching" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Close"
                        Command="{Binding CloseCommand}" />
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Classes="accent" />
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
